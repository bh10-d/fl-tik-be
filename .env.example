# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influencer_monitor?schema=public"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=3000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Provider Settings
# Options: INTERNAL_CRAWLER, mock, tiktok, external
DEFAULT_VIDEO_PROVIDER="INTERNAL_CRAWLER"

# Internal TikTok Crawler API Configuration
INTERNAL_CRAWLER_BASE_URL="http://localhost:8000"
INTERNAL_CRAWLER_API_KEY=""

# External Video Provider Configuration (Alternative)
EXTERNAL_PROVIDER_BASE_URL="https://api.external-video-provider.com/v1"
EXTERNAL_PROVIDER_API_KEY=""

# TikTok Display API Configuration (Official OAuth)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/v1/auth/tiktok/callback"

# Tracking Scheduler Configuration
TRACKING_POLL_INTERVAL_SECONDS=900
MAX_CONCURRENT_TRACKING_JOBS=5
TRACKING_INITIAL_HISTORY_LIMIT=30
TRACKING_MAX_VIDEOS_PER_SYNC=50
TRACKING_RETRY_COUNT=3
TRACKING_RETRY_BACKOFF_MS=5000
